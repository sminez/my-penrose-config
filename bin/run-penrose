#!/usr/bin/env bash
eval "$(/usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh)"
export SSH_AUTH_SOCK
eval "$(ssh-agent)"

while true; do
  # log out to a file
  penrose &> ~/.penrose.log
  [[ $? -gt 0 ]] && mv ~/.penrose.log "$HOME/prev-penrose-$(date +%s).log"
  export RESTARTED=true
done
